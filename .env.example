# nodez2ai — Environment Configuration

# Server listen port and host
PORT=8088
HOST=0.0.0.0

# Client authorization token (Bearer token for OpenAI requests)
AUTH_TOKEN=d3vin

# Optional: Z.AI login JWT (from chat.z.ai -> DevTools -> Local Storage -> "token")
# If not set, operates in guest mode (glm-5.3-flash only)
# If set, unlocks glm-5.3 and glm-5.2 (requires account level >= 10)
ZAI_TOKEN=

# SQLite token pool database path
DB_PATH=tokens.sqlite

# Token pool replenishment thresholds
TOKEN_BATCH=150
TOKEN_TARGET=750
TOKEN_LOWWATER=50

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Optional: Proxy configuration (e.g. socks5://127.0.0.1:1080 or http://127.0.0.1:7890)
# HTTP_PROXY=
# HTTPS_PROXY=
